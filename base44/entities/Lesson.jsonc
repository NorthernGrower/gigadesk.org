{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "pattern": {
      "type": "string",
      "description": "Side and cap tier the bot was trading, e.g. long/small"
    },
    "symbol": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "long",
        "short"
      ]
    },
    "score": {
      "type": "number"
    },
    "win": {
      "type": "number",
      "description": "1 when the call closed at or above break-even, 0 otherwise"
    },
    "pnl_pct": {
      "type": "number"
    },
    "pnl_usd": {
      "type": "number"
    },
    "r_multiple": {
      "type": "number",
      "description": "The result in units of the risk actually taken: the trade's pnl percent divided by the percent between its entry and stop. 1 is a stop-out, 3 is the scale-out level, negative means it lost more than the plan allowed"
    },
    "hold_hours": {
      "type": "number",
      "description": "How long the position was held, in hours, from the open to the close"
    },
    "exit_reason": {
      "type": "string"
    }
  },
  "required": [
    "pattern"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}