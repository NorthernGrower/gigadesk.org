{
  "name": "Trade",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "long",
        "short"
      ],
      "default": "long"
    },
    "mode": {
      "type": "string",
      "enum": [
        "paper",
        "real"
      ],
      "default": "paper"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "open",
        "closed",
        "rejected"
      ],
      "default": "open"
    },
    "entry_price": {
      "type": "number"
    },
    "exit_price": {
      "type": "number"
    },
    "quantity": {
      "type": "number"
    },
    "size_usd": {
      "type": "number"
    },
    "stop_price": {
      "type": "number"
    },
    "target_price": {
      "type": "number"
    },
    "target_r": {
      "type": "number",
      "description": "The R-multiple target the trade was opened with; drives its break-even management"
    },
    "scaled": {
      "type": "boolean",
      "default": false,
      "description": "Set once the 3R scale-out has booked half the position; the runner keeps its target with its stop at break-even"
    },
    "adds": {
      "type": "number",
      "default": 0,
      "description": "Pyramiding: how many add-on legs have joined the opening position (position max is twice the opening size, two adds)"
    },
    "peak_price": {
      "type": "number"
    },
    "pnl_usd": {
      "type": "number"
    },
    "pnl_pct": {
      "type": "number"
    },
    "fees_usd": {
      "type": "number"
    },
    "score": {
      "type": "number"
    },
    "pattern": {
      "type": "string",
      "description": "The side and cap tier the bot traded, e.g. long/small; drives its self-learning"
    },
    "manual": {
      "type": "boolean",
      "default": false,
      "description": "A buy the user placed by hand from the scanner, outside the bot's scan and entry gates; manual buys trade the sell logic only"
    },
    "bot_handling": {
      "type": "boolean",
      "default": true,
      "description": "When off (manual mode), the bot leaves this trade alone entirely; when on, the bot manages its sell logic \u2014 stop, target and trailing \u2014 but never sentiment-sells a manual buy"
    },
    "exchange": {
      "type": "string",
      "enum": [
        "binance_us",
        "binance",
        "bybit",
        "kucoin",
        "kraken"
      ],
      "description": "Which exchange a bot-placed real order went to"
    },
    "exchange_order_id": {
      "type": "string",
      "description": "The exchange's order id; marks a real position the bot placed and manages"
    },
    "exit_reason": {
      "type": "string",
      "enum": [
        "target",
        "stop",
        "trailing",
        "manual",
        "flipped",
        "time",
        "weakened",
        "max_loss",
        "scale"
      ]
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signal_id": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "side"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}