{
  "name": "Trade",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "long",
        "short"
      ],
      "default": "long"
    },
    "mode": {
      "type": "string",
      "enum": [
        "paper",
        "real"
      ],
      "default": "paper"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "open",
        "closed",
        "rejected"
      ],
      "default": "open"
    },
    "entry_price": {
      "type": "number"
    },
    "exit_price": {
      "type": "number"
    },
    "quantity": {
      "type": "number"
    },
    "size_usd": {
      "type": "number"
    },
    "stop_price": {
      "type": "number"
    },
    "risk_pct": {
      "type": "number",
      "description": "The risk the position was opened with, in percent of its entry: the distance from the fill to its first stop. Fixed at open, because the stop later trails up to break-even and the R multiple must divide by what was risked, not by what is left"
    },
    "target_price": {
      "type": "number"
    },
    "target_r": {
      "type": "number",
      "description": "The R-multiple target the trade was opened with; drives its break-even management"
    },
    "scaled": {
      "type": "boolean",
      "default": false,
      "description": "Set once the 3R scale-out has booked half the position; the runner keeps its target with its stop at break-even"
    },
    "adds": {
      "type": "number",
      "default": 0,
      "description": "Pyramiding: how many add-on legs have joined the opening position (position max is twice the opening size, two adds)"
    },
    "peak_price": {
      "type": "number"
    },
    "mfe_price": {
      "type": "number",
      "description": "The best price the position reached while it was open — its highest on a long, its lowest on a short. With mae_price it separates a trade that ran straight to its target from one that was deep underwater before it turned: two results the close alone reads the same"
    },
    "mae_price": {
      "type": "number",
      "description": "The worst price the position reached while it was open — its lowest on a long, its highest on a short. Seeded from the entry, so a position that never went against its side keeps its entry here"
    },
    "pnl_usd": {
      "type": "number"
    },
    "pnl_pct": {
      "type": "number"
    },
    "fees_usd": {
      "type": "number"
    },
    "r_multiple": {
      "type": "number",
      "description": "The result in units of the risk the trade actually took: pnl_pct over the entry-to-stop distance. Written when it closed, so a target and a stop-out compare across coins and position sizes"
    },
    "hold_hours": {
      "type": "number",
      "description": "How long the position was open, in hours from opened_at to the close. A stop-out after two hours and one after two weeks are different problems, and only this number tells them apart"
    },
    "score": {
      "type": "number"
    },
    "pattern": {
      "type": "string",
      "description": "The side and cap tier the bot traded, e.g. long/small; drives its self-learning"
    },
    "entry_source": {      "type": "string",
      "enum": [
        "gated",
        "v3",
        "top_pick"
      ],
      "default": "gated",
      "description": "Which rule opened the trade: the scored entry gates, the V3 algorithm, or the always-take top-picks option. Kept so the journal can measure each source separately"
    },
    "rules_snapshot": {
      "type": "object",
      "additionalProperties": true,
      "description": "The settings the trade was opened under, copied at the moment of entry: its desk and book, the score bar, the engines, the style, the timeframe and the BTC trend at the time. The rules move on, so without this copy a closed trade can only be read against today's rules rather than the ones that produced it"
    },
    "manual": {
      "type": "boolean",
      "default": false,
      "description": "A buy the user placed by hand from the scanner, outside the bot's scan and entry gates; manual buys trade the sell logic only"
    },
    "v3_algo": {
      "type": "boolean",
      "default": false,
      "description": "Opened by the V3 algorithm. V3 positions follow their own measured exit \u2014 a 2xATR stop and a 30-bar horizon \u2014 and are never closed by the target, break-even, trailing, scale-out, pyramid or sentiment rules"
    },
    "v3_stop": {
      "type": "number",
      "description": "The V3 stop: 2xATR(14) below the entry on the daily bars, fixed at open"
    },
    "v3_horizon_bars": {
      "type": "number",
      "description": "How many daily bars the V3 position may be held before it is closed on time"
    },
    "v3_atr": {
      "type": "number",
      "description": "The daily ATR(14) at the signal bar, kept so the plan can be audited later"
    },
    "bot_handling": {
      "type": "boolean",
      "default": true,
      "description": "When off (manual mode), the bot leaves this trade alone entirely; when on, the bot manages its sell logic \u2014 stop, target and trailing \u2014 but never sentiment-sells a manual buy"
    },
    "exchange": {
      "type": "string",
      "enum": [
        "binance_us",
        "binance",
        "bybit",
        "kucoin",
        "kraken"
      ],
      "description": "Which exchange a bot-placed real order went to"
    },
    "exchange_order_id": {
      "type": "string",
      "description": "The exchange's order id; marks a real position the bot placed and manages"
    },
    "imported": {
      "type": "boolean",
      "default": false,
      "description": "A real position the wallet sync imported from the exchange rather than one the bot bought. It carries no exchange order id but is the desk's own: the bot enforces its stop, target, trailing and loss cap and closes it with a real sell, exactly as it does a position it opened"
    },
    "exit_reason": {
      "type": "string",
      "enum": [
        "target",
        "stop",
        "trailing",
        "manual",
        "flipped",
        "time",
        "weakened",
        "max_loss",
        "scale",
        "synced"
      ],
      "description": "How the trade closed. manual is a close you made (from the desk or the call card); synced is the wallet sync closing a position the exchange no longer holds — sold or moved outside the app, which is never your hand on the desk"
    },
    "quote_asset": {
      "type": "string",
      "enum": [
        "USD",
        "BTC"
      ],
      "default": "USD",
      "description": "The currency this trade's prices are recorded in. USD trades price in dollars; a BTC-quoted trade prices on its Bitcoin market, e.g. SOL/XBT, and carries the rate that was used so its dollar figures can be read back"
    },
    "fx_usd": {
      "type": "number",
      "description": "The USD value of one unit of quote_asset when the trade opened — 1 for USD trades, BTC's dollar price for BTC-quoted ones"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signal_id": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "side"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}