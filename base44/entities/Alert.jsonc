{
  "name": "Alert",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "new_setup",
        "target_hit",
        "stop_hit",
        "bot_open",
        "bot_close",
        "daily_goal",
        "order_failed"
      ],
      "default": "new_setup"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "danger"
      ],
      "default": "info"
    },
    "mode": {
      "type": "string",
      "enum": [
        "paper",
        "live"
      ],
      "description": "Which desk the alert belongs to \u2014 paper bot results or live exchange trading"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "trade_id": {
      "type": "string"
    },
    "signal_id": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}