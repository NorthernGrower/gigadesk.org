{
  "name": "Watchlist",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "coingecko_id": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "symbol"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}