{
  "name": "EquityCandle",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "format": "date",
      "description": "UTC day this candle covers; one record per day"
    },
    "owner": {
      "type": "string",
      "description": "The user's id whose paper equity this candle tracks"
    },
    "open": {
      "type": "number",
      "description": "Equity when the day started"
    },
    "high": {
      "type": "number"
    },
    "low": {
      "type": "number"
    },
    "close": {
      "type": "number",
      "description": "Equity at the most recent bot cycle"
    },
    "realized": {
      "type": "number",
      "description": "Paper profit and loss booked that day"
    },
    "trades": {
      "type": "number",
      "description": "Paper trades closed that day"
    }
  },
  "required": [
    "day"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}