{
  "name": "BotConfig",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "off",
        "approve",
        "auto"
      ],
      "default": "approve",
      "description": "off = signals only, approve = bot proposes and you confirm, auto = bot opens and closes on its own"
    },
    "profit_mode": {
      "type": "string",
      "enum": [
        "compound",
        "stack"
      ],
      "default": "compound",
      "description": "compound = booked profits return to the trading pool, stack = profits are set aside and only the starting capital (plus losses) is traded"
    },
    "sentiment_watch": {
      "type": "boolean",
      "default": true,
      "description": "Each full cycle re-reads the chart behind every open trade and closes ones the market has turned against"
    },
    "trading_style": {
      "type": "string",
      "enum": [
        "timid",
        "mild",
        "aggressive"
      ],
      "default": "mild",
      "description": "timid = pickier setups and smaller risk, mild = your rules as set, aggressive = lower score bar, bigger risk, stagnant trades cut early"
    },
    "starting_balance": {
      "type": "number",
      "default": 10000
    },
    "cash_balance": {
      "type": "number",
      "default": 10000
    },
    "risk_per_trade_pct": {
      "type": "number",
      "default": 4
    },
    "max_open_positions": {
      "type": "number",
      "default": 8
    },
    "default_stop_pct": {
      "type": "number",
      "default": 2.5
    },
    "target_pct": {
      "type": "number",
      "default": 2
    },
    "daily_target_pct": {
      "type": "number",
      "default": 2
    },
    "trailing_stop": {
      "type": "boolean",
      "default": true
    },
    "trailing_trigger_pct": {
      "type": "number",
      "default": 1
    },
    "trailing_distance_pct": {
      "type": "number",
      "default": 1.5
    },
    "allow_shorts": {
      "type": "boolean",
      "default": true
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "15m",
        "1h",
        "4h",
        "12h",
        "1d",
        "1w",
        "1M"
      ],
      "default": "1h"
    },
    "market_cap_scope": {
      "type": "string",
      "enum": [
        "all",
        "large",
        "mid",
        "small"
      ],
      "default": "all"
    },
    "min_score": {
      "type": "number",
      "default": 62
    },
    "require_daily_target": {
      "type": "boolean",
      "default": true
    },
    "cooldown_minutes": {
      "type": "number",
      "default": 120
    },
    "auto_run": {
      "type": "boolean",
      "default": true
    },
    "last_cycle_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current cycle began; keeps overlapping cycles from double-opening positions"
    },
    "real_orders_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When on, qualifying longs are sent to the chosen exchange as market orders"
    },
    "real_connection_id": {
      "type": "string",
      "description": "The ExchangeConnection real orders are sent to"
    },
    "real_sizing_mode": {
      "type": "string",
      "enum": [
        "paper",
        "fixed"
      ],
      "default": "paper",
      "description": "paper = spend what the paper sizing computed, fixed = always spend fixed_order_usd"
    },
    "fixed_order_usd": {
      "type": "number",
      "default": 100
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "mode"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}