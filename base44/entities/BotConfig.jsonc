{
  "name": "BotConfig",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "off",
        "approve",
        "auto"
      ],
      "default": "approve",
      "description": "off = signals only, approve = bot proposes and you confirm, auto = bot opens and closes on its own"
    },
    "active_desk": {
      "type": "string",
      "enum": [
        "paper",
        "live"
      ],
      "default": "paper",
      "description": "Which desk the dashboard opens on; switching desks never touches the other one's data"
    },
    "live_rules": {
      "type": "object",
      "additionalProperties": true,
      "description": "Rules that govern live trading only \u2014 sizing, slots, score bar, trailing, cooldown, pyramiding, engines and the live budget. Fully separate from the paper rules: a live rule never falls back to a paper value, only to its own live default"
    },
    "btc_rules": {
      "type": "object",
      "additionalProperties": true,
      "description": "The paper Bitcoin book's own trade rules: score bar, risk, slots, cooldowns, trailing, engines and scan settings. Seeded once from the dollar paper rules, then kept apart. Same trade logic as the dollar book, its own values"
    },
    "profit_mode": {
      "type": "string",
      "enum": [
        "compound",
        "stack"
      ],
      "default": "compound",
      "description": "compound = booked profits return to the trading pool, stack = profits are set aside and only the starting capital (plus losses) is traded"
    },
    "sentiment_watch": {
      "type": "boolean",
      "default": true,
      "description": "Each full cycle re-reads the chart behind every open trade and closes ones the market has turned against"
    },
    "trading_style": {
      "type": "string",
      "enum": [
        "timid",
        "mild",
        "aggressive"
      ],
      "default": "mild",
      "description": "timid = pickier setups and smaller risk, mild = your rules as set, aggressive = lower score bar, bigger risk, stagnant trades cut early"
    },
    "confluence_v2": {
      "type": "boolean",
      "default": true,
      "description": "Advanced structure engine: Fibonacci pullbacks, Elliott wave counts and multi-touch zones. Turn off to revert to the previous scoring"
    },
    "engine_v2": {
      "type": "boolean",
      "default": true,
      "description": "Structural entry rules: the higher timeframe must confirm the trade, ADX 25 with the DI pair owned, 3 confluences, no chasing and a 5% max stretch. Turn off to revert to score-only entries"
    },
    "champion_engine": {
      "type": "boolean",
      "default": true,
      "description": "The optimizer champion's refinements on top of the entry rules: 2.5R targets with break-even after +1.2R, 1.5x volume, and longs only while BTC's tape is risk-off. Turn off to trade the base V2 rules"
    },
    "btc_gate": {
      "type": "boolean",
      "default": true,
      "description": "The champion engine's BTC regime gate: longs only trade while BTC's 24h tape is risk-off (under -1%). Turn off to let the desk take longs in any tape"
    },
    "combo_engine": {
      "type": "boolean",
      "default": true,
      "description": "The optimizer's combined champion stack: score bar 70, ADX 28, 2x-4x volume, stochastic agreement, RSI chase block, conviction candles, BTC risk-off longs, 6R targets, break-even at +1.2R and a 3R scale-out (half booked at +3R, runner stop at break-even). Turn off to trade the previous managed rules"
    },
    "margin_engine": {
      "type": "boolean",
      "default": false,
      "description": "The optimizer's Kraken-margin stack: 3R targets, 50% conviction candles, majors + AVAX only. Leverage moves losses as fast as gains \u2014 off by default"
    },
    "v3_algo": {
      "type": "boolean",
      "default": false,
      "description": "The paper desk's V3 algorithm: the researched daily breakout logic (docs/UNIFIED_LOGIC.md in the research repo) replaces the score bar for this desk's entries. Daily bars, long only, $5m liquidity floor, BTC above its 200-day average, a survivor candle formation behind it. Exit is a 2xATR stop with no target, held up to 30 daily bars. Off by default; the live desk keeps its own switch in live_rules.v3_algo"
    },
    "analyst_on": {
      "type": "boolean",
      "default": false,
      "description": "The paper desk's read-only analyst: once a day it writes a short note under the desk panels, from this desk's own closed trades, open positions, rules, recent alerts, the scanner's setups, BTC's tape and the watchlist, plus what each entry source is doing against the backtest that set its expectation. Top picks are never held to a backtest. Read-only by construction — no order path, it cannot open, close, size or approve a trade. Off by default, and off means no read and no call at all; the live desk keeps its own switch in live_rules.analyst_on"
    },
    "margin_leverage": {
      "type": "number",
      "default": 2,
      "description": "Leverage level margin-engine shorts open at on Kraken (1-5); gains and losses both scale with it"
    },
    "pyramid": {
      "type": "boolean",
      "default": false,
      "description": "Pyramiding: winners earn size \u2014 when a trade is up by the add trigger, another leg of half the opening size joins at market, up to position max (twice the opening size, two add legs)"
    },
    "pyramid_trigger_pct": {
      "type": "number",
      "default": 1.5,
      "description": "The gain a trade must hold before the bot adds to it"
    },
    "starting_balance": {
      "type": "number",
      "default": 10000
    },
    "btc_starting_btc": {
      "type": "number",
      "default": 0,
      "description": "The paper Bitcoin book's bankroll, set in BTC. Every cycle translates it at the live BTC rate and uses the dollars as this book's own starting balance, separate from the dollar desk. 0 keeps the legacy dollar bankroll in btc_starting_balance"
    },
    "btc_starting_balance": {
      "type": "number",
      "default": 10000,
      "description": "The paper desk's Bitcoin book bankroll in USD, used only when btc_starting_btc is not set. A BTC-quoted paper trade is sized, banked and reset against this balance only, so a dollar drawdown can never starve the Bitcoin book or the other way round"
    },
    "btc_cash_balance": {
      "type": "number",
      "default": 10000,
      "description": "The paper Bitcoin book's live cash. Re-anchored every cycle from its own trades — this balance plus what they booked, minus what they hold — so it can never drift or borrow from the dollar balance"
    },
    "cash_balance": {
      "type": "number",
      "default": 10000
    },
    "risk_per_trade_pct": {
      "type": "number",
      "default": 4
    },
    "max_open_positions": {
      "type": "number",
      "default": 8
    },
    "default_stop_pct": {
      "type": "number",
      "default": 2.5
    },
    "target_pct": {
      "type": "number",
      "default": 2
    },
    "daily_target_pct": {
      "type": "number",
      "default": 2
    },
    "max_trade_loss_pct": {
      "type": "number",
      "default": 20,
      "description": "Per-trade max loss guard: a trade down this percent of its own deployed size is force-closed at market on the next cycle, even if its stop has not fired. 0 = off"
    },
    "profit_lock": {
      "type": "boolean",
      "default": true,
      "description": "The live desk's profit lock: once a position is up by the arm threshold, its stop is raised to keep the share below of the best price it reached, so a run books most of itself instead of riding back down to the entry stop. Runs every five minutes on the desk guard, so it holds while the app is closed, and it can only ever raise a stop, never lower one — a breached stop still fills at its own level. The exit study measured the trade-off honestly: protecting the peak lifts the win rate and lowers the money per trade, so the default keeps half the peak and arms only at +2%. Off = the stop only ever moves by break-even and trailing in the app's cycle"
    },
    "lock_arm_pct": {
      "type": "number",
      "default": 2,
      "description": "How far in profit a live position must be before the profit lock raises its stop, as a percent of the entry"
    },
    "giveback_pct": {
      "type": "number",
      "default": 50,
      "description": "How much of the best profit the lock allows a trade to give back, as a percent of the peak gain. 50 keeps half of the move, 40 keeps more but exits sooner, 0 turns the lock off"
    },
    "trailing_stop": {
      "type": "boolean",
      "default": true
    },
    "trailing_trigger_pct": {
      "type": "number",
      "default": 3
    },
    "trailing_distance_pct": {
      "type": "number",
      "default": 1.5
    },
    "allow_shorts": {
      "type": "boolean",
      "default": true
    },
    "btc_gate_mode": {
      "type": "string",
      "enum": [
        "any",
        "risk_off_only"
      ],
      "default": "any",
      "description": "Which BTC tape longs may trade into. risk_off_only is the champion engine's original rule and blocks every long while BTC is up on the day; any keeps medium-term risk controls but stops vetoing longs in a bounce"
    },
    "v3_profile": {
      "type": "string",
      "enum": [
        "strict",
        "loose",
        "aggressive"
      ],
      "default": "loose",
      "description": "Which V3 rule set runs: strict is the original composition (about 23 trades a year), loose adds the 20-bar breakout and a $1m floor, aggressive also drops the BTC trend gate"
    },
    "v3_exit": {
      "type": "boolean",
      "default": false,
      "description": "Runs the measured exit on this desk's own entries: the exit study replayed V3's entries under 21 exit rules, and holding to the horizon with the 2xATR stop earned +7.18%, +7.76% and +1.62% per trade out of sample (net of the per-pair cost model) against the current fixed target's +1.35%, +2.40% and -0.48% — the fixed target was the single largest drag. A trade opened with this on is booked with that exit instead: a 2xATR stop from the entry bar, no target, and a 30-bar horizon, so the bot holds through a normal pullback rather than stopping out of a move that is still going. The target, break-even, scale-out, trailing and sentiment exits are then skipped for it, exactly as V3's own exits are. Off by default; the live desk keeps its own switch in live_rules.v3_exit"
    },
    "always_take_top": {
      "type": "boolean",
      "default": false,
      "description": "When on, the desk buys its highest scoring coins each cycle even if they miss the entry gates. Exits, stops, sizing and every other bot rule still apply"
    },
    "always_take_count": {
      "type": "number",
      "default": 5,
      "description": "How many top picks the always-take option buys per cycle, 1 to 10, still limited by free slots and risk brakes"
    },
    "active_book": {
      "type": "string",
      "enum": [
        "USD",
        "BTC"
      ],
      "default": "USD",
      "description": "Which book the desk page is showing: the dollar market or the Bitcoin market. The two are separate books — their own bankroll, positions, cooldowns, brakes, stats and scan — so switching the page changes every figure on it. Saved with the desk (active_desk), so a reload comes back to the same view"
    },
    "btc_markets": {      "type": "boolean",
      "default": false,
      "description": "Also trade Kraken's BTC-quoted markets as a second, fully separate book on this desk. The Bitcoin market is scanned by the same engine and traded by the same rules, but it has its own bankroll (btc_starting_balance), its own cash, its own slots, its own cooldowns, its own risk brakes and its own lessons \u2014 a dollar position never takes a Bitcoin slot and a dollar drawdown never stops a Bitcoin entry, or the other way round. Prices on those trades are in BTC with the dollar rate recorded when they opened, so their P&L still reads in USD. Off by default; the live desk keeps its own switch in live_rules.btc_markets. The live book sizes from the account's Bitcoin spot balance and takes longs only \u2014 a Bitcoin short would need margin on a market this book has not been measured on"
    },
    "timeframe": {
      "type": "string",      "enum": [
        "15m",
        "1h",
        "4h",
        "12h",
        "1d",
        "1w",
        "1M"
      ],
      "default": "1h"
    },
    "market_cap_scope": {
      "type": "string",
      "enum": [
        "all",
        "large",
        "mid",
        "small"
      ],
      "default": "all"
    },
    "min_score": {
      "type": "number",
      "default": 62
    },
    "score_bar": {
      "type": "number",
      "default": 70,
      "description": "The paper pool's own minimum setup score. 70 is the backtested most profitable bar; a lower number takes more trades with weaker setups"
    },
    "require_daily_target": {
      "type": "boolean",
      "default": true
    },
    "cooldown_minutes": {
      "type": "number",
      "default": 4320,
      "description": "How long a desk leaves a just-closed symbol alone; the optimizer winner is 72 hourly bars"
    },
    "auto_run": {
      "type": "boolean",
      "default": true
    },
    "last_cycle_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current cycle began; keeps overlapping cycles from double-opening positions"
    },
    "last_wallet_sync_at": {
      "type": "number",
      "description": "When the wallet reconciliation last ran, so it stays throttled to one sync per 10 minutes"
    },
    "real_orders_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When on, qualifying longs are sent to the chosen exchange as market orders. Pausing stops new entries but keeps managing open real positions"
    },
    "real_connection_id": {
      "type": "string",
      "description": "The ExchangeConnection real orders are sent to"
    },
    "real_sizing_mode": {
      "type": "string",
      "enum": [
        "paper",
        "fixed"
      ],
      "default": "paper",
      "description": "paper = spend what the paper sizing computed, fixed = always spend fixed_order_usd"
    },
    "fixed_order_usd": {
      "type": "number",
      "default": 100
    },
    "live_cap_usd": {
      "type": "number",
      "default": 0,
      "description": "The most exchange money real orders may put to work in total across open positions; 0 = no limit"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "mode"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}