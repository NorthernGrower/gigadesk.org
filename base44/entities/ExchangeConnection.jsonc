{
  "name": "ExchangeConnection",
  "type": "object",
  "properties": {
    "exchange": {
      "type": "string",
      "enum": [
        "binance_us",
        "binance",
        "bybit",
        "kucoin",
        "kraken"
      ]
    },
    "label": {
      "type": "string"
    },
    "api_key": {
      "type": "string",
      "description": "AES-256-GCM encrypted at rest; never readable by any client",
      "rls": {
        "read": false
      }
    },
    "api_secret": {
      "type": "string",
      "description": "AES-256-GCM encrypted at rest; never readable by any client",
      "rls": {
        "read": false
      }
    },
    "passphrase": {
      "type": "string",
      "description": "AES-256-GCM encrypted at rest; never readable by any client",
      "rls": {
        "read": false
      }
    },
    "key_hint": {
      "type": "string"
    },
    "testnet": {
      "type": "boolean",
      "default": false
    },
    "allow_trading": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "error"
      ],
      "default": "error"
    },
    "status_message": {
      "type": "string"
    },
    "can_trade": {
      "type": "boolean"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "balances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "balance_usd": {
      "type": "number",
      "description": "Last saved quote-currency balance, kept on the connection so the desk never goes blank"
    },
    "balance_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the saved balance was last read from the exchange"
    }
  },
  "required": [
    "exchange",
    "api_key",
    "api_secret"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}